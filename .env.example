# LearnPath Progressive E-Learning Platform - Environment Configuration

# Application Server
PORT=3000
APP_URL="https://example.com"

# Supabase Configuration (PostgreSQL Database, Auth, Storage)
# Get these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Authentication & JWT Configuration
JWT_SECRET="your-secure-random-256-bit-secret-token"
SESSION_EXPIRY_HOURS=24

# Optional: Gemini API Key for adaptive explanation generation
GEMINI_API_KEY=""
